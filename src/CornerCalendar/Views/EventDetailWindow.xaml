<Window x:Class="CornerCalendar.Views.EventDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日期详情"
        Width="380" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        MaxHeight="620">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <StackPanel>
            <Grid Margin="0,0,0,3">
                <TextBlock x:Name="DayTitle"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnCloseClick"
                        ToolTip="关闭">
                    <Path Data="M4,4 L20,20 M20,4 L4,20"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </Grid>

            <TextBlock x:Name="DaySubtitle"
                       FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,14" />

            <Border Background="{DynamicResource HoverBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="日历信息"
                               FontSize="{DynamicResource FontSizeSecondary}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,7" />
                    <TextBlock x:Name="LunarText"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="FestivalText"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TodayAccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="HolidayText"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TodayAccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="28" Height="28"
                                    Background="{DynamicResource RestDayBadgeBrush}"
                                    CornerRadius="14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <TextBlock Text="宜"
                                           FontSize="{DynamicResource FontSizeSecondary}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource RestDayBadgeTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2"
                                       x:Name="SuitableText"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="28" Height="28"
                                    Background="{DynamicResource WorkdayBadgeBrush}"
                                    CornerRadius="14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <TextBlock Text="忌"
                                           FontSize="{DynamicResource FontSizeSecondary}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WorkdayBadgeTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2"
                                       x:Name="AvoidText"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Height="1"
                    Background="{DynamicResource SeparatorBrush}"
                    Margin="0,16,0,12" />

            <Grid Margin="0,0,0,8">
                <TextBlock Text="当天日程"
                           FontSize="{DynamicResource FontSizeItemTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="EventCountText"
                           HorizontalAlignment="Right"
                           FontSize="{DynamicResource FontSizeFootnote}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <ScrollViewer MaxHeight="250"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DayEventsPanel" />
            </ScrollViewer>
            <TextBlock x:Name="NoEventsText"
                       Text="当天没有日程"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,2"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>