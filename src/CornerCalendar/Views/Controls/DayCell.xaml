<UserControl x:Class="CornerCalendar.Views.Controls.DayCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="52" Height="62"
             Cursor="Hand"
             MouseLeftButtonUp="OnDayClick">

    <Grid>
        <!-- 森日程角标：位于班/休左侧，颜色由活动语义决定 -->
        <Border x:Name="SenBadge"
                Width="18" Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="-2,1,0,0"
                CornerRadius="9"
                Background="{DynamicResource BackgroundBrush}"
                Panel.ZIndex="3"
                Visibility="Collapsed">
            <TextBlock x:Name="SenBadgeText"
                       FontSize="9"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 法定节假日状态：休/班只占一个小角标，不参与主信息堆叠 -->
        <Border x:Name="HolidayBadge"
                Width="16" Height="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                CornerRadius="8"
                Panel.ZIndex="3"
                Visibility="Collapsed">
            <TextBlock x:Name="HolidayBadgeText"
                       FontSize="8"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 森日程阶段圆圈；今日和蓝色选中圆圈位于更高视觉层 -->
        <Ellipse x:Name="SenCircle"
                 Width="28" Height="28"
                 Fill="Transparent"
                 StrokeThickness="2"
                 Visibility="Collapsed"
                 VerticalAlignment="Top"
                 Margin="0,8,0,0" />

        <!-- 今日高亮圆形背景（缩小，不遮挡农历） -->
        <Ellipse x:Name="TodayCircle"
                 Width="28" Height="28"
                 Fill="{DynamicResource TodayAccentBrush}"
                 Visibility="Collapsed"
                 VerticalAlignment="Top"
                 Margin="0,8,0,0" />

        <!-- 选中日期圆形边框 -->
        <Ellipse x:Name="SelectedCircle"
                 Width="28" Height="28"
                 Stroke="{DynamicResource TodayAccentBrush}"
                 StrokeThickness="1.5"
                 Fill="Transparent"
                 Visibility="Collapsed"
                 VerticalAlignment="Top"
                 Margin="0,8,0,0" />

        <!-- 日期数字 -->
        <TextBlock x:Name="DayText"
                   Text="{Binding DayNumber}"
                   FontSize="{DynamicResource FontSizeItemTitle}"
                   FontWeight="Normal"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <!-- 单行日历附加信息：节日优先，否则显示农历日（可见性由代码后台控制） -->
        <StackPanel x:Name="CalendarInfoPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,11"
                    Panel.ZIndex="2">
            <TextBlock x:Name="CalendarInfoText"
                       FontSize="{DynamicResource FontSizeCalendarInfo}"
                       MaxWidth="48"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- 事件圆点（最多3个，颜色对应事件本身） -->
        <StackPanel x:Name="EventDots"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,2"
                    Panel.ZIndex="2"
                    Visibility="Collapsed">
            <Ellipse x:Name="Dot1" Width="4" Height="4" Margin="1,0" Visibility="Collapsed" />
            <Ellipse x:Name="Dot2" Width="4" Height="4" Margin="1,0" Visibility="Collapsed" />
            <Ellipse x:Name="Dot3" Width="4" Height="4" Margin="1,0" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>