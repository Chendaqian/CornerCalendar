<UserControl x:Class="CornerCalendar.Views.Controls.MonthCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CornerCalendar.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 月份导航 -->
            <RowDefinition Height="Auto" />  <!-- 星期头 -->
            <RowDefinition Height="Auto" />  <!-- 日历网格 -->
        </Grid.RowDefinitions>

        <!-- 月份导航栏 -->
        <Grid Grid.Row="0" Height="52" Margin="5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 上一月按钮 -->
            <Button Grid.Column="0"
                    x:Name="PrevButton"
                    Content="‹"
                    FontSize="{DynamicResource FontSizeHeading}" FontWeight="Bold"
                    Width="36" Height="36"
                    Background="Transparent"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center" />

            <!-- 月份标题 + 今天按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="MonthTitle"
                           Text="{Binding MonthDisplay}"
                           FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Cursor="Hand"
                           VerticalAlignment="Center" />
                <Button x:Name="TodayButton"
                        Content="今天"
                        FontSize="{DynamicResource FontSizeSecondary}" FontWeight="SemiBold"
                        Padding="8,3"
                        Margin="10,0,0,0"
                        Background="{DynamicResource TodayAccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center" />
            </StackPanel>

            <!-- 下一月按钮 -->
            <Button Grid.Column="2"
                    x:Name="NextButton"
                    Content="›"
                    FontSize="{DynamicResource FontSizeHeading}" FontWeight="Bold"
                    Width="36" Height="36"
                    Background="Transparent"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- 星期头（动态更新，支持周日起始） -->
        <Grid Grid.Row="1" Margin="2,0,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WeekNumberHeaderColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" x:Name="WeekHeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="H0" FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="H1" FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Name="H2" FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3" x:Name="H3" FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" x:Name="H4" FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" x:Name="H5" FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="6" x:Name="H6" FontSize="{DynamicResource FontSizeSecondary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- 日历网格 (6×7) -->
        <Grid Grid.Row="2" Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WeekNumberGridColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" x:Name="WeekNumberGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Number}"
                                   ToolTip="{Binding ToolTip}"
                                   ToolTipService.InitialShowDelay="0"
                                   ToolTipService.ShowDuration="60000"
                                   FontSize="{DynamicResource FontSizeSecondary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Column="1" x:Name="CalendarGrid" Margin="0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:DayCell DayData="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>