<Window x:Class="CornerCalendar.Views.SenSchedulePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="森日程预览"
        Width="900"
        Height="560"
        MinWidth="680"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,5,0,12"
                   FontSize="{DynamicResource FontSizeFootnote}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <DataGrid x:Name="ActivityGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  BorderBrush="{DynamicResource SeparatorBrush}"
                  RowBackground="{DynamicResource BackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="54" />
                <DataGridTextColumn Header="活动" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="工作量(天)" Binding="{Binding WorkloadDays}" Width="90" />
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartDate, StringFormat=yyyy/M/d}" Width="100" />
                <DataGridTextColumn Header="结束时间" Binding="{Binding EndDate, StringFormat=yyyy/M/d}" Width="100" />
                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>