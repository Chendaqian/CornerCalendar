<Window x:Class="CornerCalendar.Views.WeatherForecastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="七天天气"
        Width="650" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="七天天气"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="CityText"
                               FontSize="{DynamicResource FontSizeSecondary}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnCloseClick"
                        ToolTip="关闭">
                    <Path Data="M4,4 L20,20 M20,4 L4,20"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </Grid>

            <Border Height="1"
                    Background="{DynamicResource SeparatorBrush}"
                    Margin="0,8,0,12" />

            <ItemsControl x:Name="ForecastItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource HoverBrush}"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="8,10"
                                Margin="3"
                                ToolTip="{Binding ToolTip}"
                                ToolTipService.InitialShowDelay="200">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DateLabel}"
                                           FontSize="{DynamicResource FontSizeSecondary}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <ContentControl Content="{Binding Icon}"
                                                Width="34" Height="34"
                                                Margin="0,8,0,5"
                                                HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="{DynamicResource FontSizeFootnote}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TemperatureRange}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>