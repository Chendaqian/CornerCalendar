<Window x:Class="CornerCalendar.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CornerCalendar.Views.Controls"
        Title="CornerCalendar"
        Width="486" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        MaxHeight="800">

    <Border x:Name="RootBorder"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            Opacity="0"
            RenderTransformOrigin="0.5,1">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
        </Border.LayoutTransform>
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 天气 -->
                <RowDefinition Height="Auto" />  <!-- 日历 -->
                <RowDefinition Height="Auto" />  <!-- 分隔线 + 事件区域 -->
            </Grid.RowDefinitions>

            <!-- 天气摘要：多个位置时使用左右按钮切换 -->
            <Border Grid.Row="0" x:Name="WeatherSection"
                    Margin="10,8,30,0"
                    Padding="4,7,10,7"
                    Background="{DynamicResource HoverBrush}"
                    CornerRadius="8"
                    Cursor="Hand"
                    PreviewMouseLeftButtonUp="OnWeatherSectionPreviewMouseLeftButtonUp"
                    ToolTipService.InitialShowDelay="200">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="45" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Grid.ColumnSpan="2"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl Grid.Row="0"
                                        x:Name="WeatherIconHost"
                                        Width="26"
                                        Height="26"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0"
                                   x:Name="WeatherCityText"
                                   Text="天气"
                                   FontSize="{DynamicResource FontSizeSecondary}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="30,0,0,0" />
                        <TextBlock Grid.Row="1"
                                   x:Name="WeatherSummaryText"
                                   Text="加载中..."
                                   FontSize="{DynamicResource FontSizeFootnote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </Grid>
                    <TextBlock Grid.Column="2" x:Name="WeatherTemperatureText"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,2,0">
                        <Run x:Name="CurrentTemperatureRun"
                             Text="--°"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                    </TextBlock>
                    <StackPanel Grid.Column="3"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Margin="8,0">
                        <TextBlock x:Name="WeatherExtraText"
                                   FontSize="{DynamicResource FontSizeFootnote}"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left">
                            <Run Text="降水 "
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run x:Name="WeatherPrecipitationRun"
                                 Text="--%"
                                 Foreground="{DynamicResource TodayAccentBrush}" />
                            <Run Text=" · 风 "
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run x:Name="WeatherWindRun"
                                 Text="-- km/h"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock x:Name="WeatherDetailsText"
                                   FontSize="{DynamicResource FontSizeFootnote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left">
                            <Run Text="体感 "
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run x:Name="WeatherFeelsLikeRun"
                                 Text="--°"
                                 Foreground="{DynamicResource WeatherWarmBrush}" />
                            <Run Text=" · 湿度 "
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run x:Name="WeatherHumidityRun"
                                 Text="--%"
                                 Foreground="{DynamicResource WeatherHumidityBrush}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="PreviousWeatherButton"
                                Width="20" Height="28" Content="‹"
                                FontSize="20" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" Click="OnPreviousWeatherClick"
                                ToolTip="上一个天气位置" />
                        <TextBlock x:Name="WeatherPageText" MinWidth="22"
                                   Text="1/1" TextAlignment="Center"
                                   FontSize="{DynamicResource FontSizeFootnote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="NextWeatherButton"
                                Width="20" Height="28" Content="›"
                                FontSize="20" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" Click="OnNextWeatherClick"
                                ToolTip="下一个天气位置" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button Grid.Row="0"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    Panel.ZIndex="10"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnClosePopupClick"
                    ToolTip="关闭">
                <Path Data="M4,4 L20,20 M20,4 L4,20"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Uniform"
                      Width="11"
                      Height="11" />
            </Button>

            <!-- 月历控件 -->
            <local:MonthCalendar Grid.Row="1"
                                 x:Name="Calendar"
                                 Margin="10,6,10,6" />

            <!-- 分隔线 + 事件区域 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 分隔线 -->
                    <RowDefinition Height="Auto" />  <!-- 标题栏（近期事件 + 齿轮） -->
                    <RowDefinition Height="208" />    <!-- 事件列表（固定高度，恰好4条） -->
                </Grid.RowDefinitions>

                <!-- 分隔线 -->
                <Border Grid.Row="0"
                        Height="1"
                        Background="{DynamicResource SeparatorBrush}"
                        Margin="16,5,16,5" />

            <!-- 标题栏：左侧"近期事件"，右侧刷新+齿轮+关闭 -->
                <Grid Grid.Row="1" Margin="16,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="近期事件"
                               FontSize="{DynamicResource FontSizeSecondary}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- 刷新按钮 -->
                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Width="31" Height="31"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnRefreshClick"
                            ToolTip="刷新日历"
                            Margin="0,0,3,0">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform"
                              Width="18" Height="18" />
                    </Button>

                    <!-- 森日程开关 -->
                    <Button Grid.Column="2"
                            x:Name="SenScheduleButton"
                            Width="31" Height="31"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnSenScheduleClick"
                            ToolTip="开启森日程"
                            Margin="0,0,3,0">
                        <TextBlock x:Name="SenScheduleButtonText"
                                   Text="森"
                                   FontSize="{DynamicResource FontSizeSecondary}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- 齿轮图标按钮 -->
                    <Button Grid.Column="3"
                            x:Name="SettingsButton"
                            Width="31" Height="31"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnSettingsClick"
                            ToolTip="设置">
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,13L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform"
                              Width="18" Height="18" />
                    </Button>

                    <!-- 关闭按钮：只有显式点击这里才隐藏主窗口 -->
                    <Button Grid.Column="4"
                            x:Name="ClosePopupButton"
                            Width="31" Height="31"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnClosePopupClick"
                            ToolTip="关闭日历">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform"
                              Width="18" Height="18" />
                    </Button>
                </Grid>

                <!-- 事件列表（固定高度，超出滚动，底部留白保护圆角） -->
                <ScrollViewer Grid.Row="2"
                              x:Name="EventScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              Padding="5,0,5,16"
                              Margin="0,0,0,5">
                    <StackPanel>
                        <ItemsControl x:Name="EventListControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:EventItem EventData="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- End 标记：仅在事件列表末尾显示 -->
                        <TextBlock x:Name="EndMarker"
                                   Text="- End -"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 无事件占位文案 -->
                <TextBlock Grid.Row="2"
                           x:Name="NoEventsText"
                           Text="暂无近期事件"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8"
                           Visibility="Collapsed" />

                <!-- 数据加载失败提示（ISSUES #12：不再静默显示空日历） -->
                <TextBlock Grid.Row="2"
                           x:Name="LoadErrorText"
                           Text="日程加载失败，请检查网络或数据源设置"
                           FontSize="{DynamicResource FontSizeSecondary}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           TextWrapping="Wrap"
                           Margin="16,10,16,0"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>