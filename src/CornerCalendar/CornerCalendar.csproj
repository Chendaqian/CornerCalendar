<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 需要安装 Windows 10 SDK 后取消注释以下行以启用真实日历 API -->
    <!-- <UseWinRT>true</UseWinRT> -->
    <!-- <WindowsPackageType>None</WindowsPackageType> -->
    <RootNamespace>CornerCalendar</RootNamespace>
    <AssemblyName>CornerCalendar</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 发布选项（与 scripts/Publish-Artifacts.ps1 及 .github/workflows/release.yml 保持一致）：
         多文件目录制品（不启用单文件与单文件压缩），默认自包含 win-x64 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StartupObject>CornerCalendar.App</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageProjectUrl>https://github.com/Chendaqian/CornerCalendar</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Release（含 publish 制品）不生成 PDB -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build-verify\**" />
    <EmbeddedResource Remove="build-verify\**" />
    <None Remove="build-verify\**" />
    <Page Remove="build-verify\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.0" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <!-- MIT: https://github.com/6tail/lunar-csharp；提供按日期计算的黄历宜忌。 -->
    <PackageReference Include="lunar-csharp" Version="1.6.8" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- 需要安装 Windows 10 SDK 后取消注释以下行 -->
    <!-- <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.1" /> -->
  </ItemGroup>

  <!-- ISSUES #17：单元测试访问 internal 成员 -->
  <ItemGroup>
    <InternalsVisibleTo Include="CornerCalendar.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 托盘图标和历史资料均使用程序目录中的文件；EXE 文件图标由 ApplicationIcon 单独引用 -->
    <Resource Include="Resources\icon.ico" />
    <!-- 出厂默认配置：首次安装（本地无 settings.json）与恢复默认时读取 -->
    <EmbeddedResource Include="Resources\default-settings.json" LogicalName="CornerCalendar.Resources.default-settings.json" />
    <None Update="Resources\HistoryToday\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 跑者动画帧（来源 RunCat365 / RunnerGallery，见设置"关于"页署名） -->
    <None Update="Resources\Runners\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>